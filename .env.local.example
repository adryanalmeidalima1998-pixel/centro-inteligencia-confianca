# ==============================================================
# CENTRO DE INTELIGÊNCIA · ASSOCIAÇÃO DESPORTIVA CONFIANÇA
# Copie este arquivo para .env.local apenas no desenvolvimento.
# Em produção, configure os valores no provedor de infraestrutura.
# Nunca versione .env.local nem credenciais reais.
# ==============================================================

# ----------------------------------------------------------------
# APLICAÇÃO / AUTENTICAÇÃO
# ----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-uma-string-longa-aleatoria

AUTH_EMAIL=inteligencia@adconfianca.com.br
AUTH_PASSWORD=defina-uma-senha-forte

SCOUTING_EMAIL=scouting@adconfianca.com.br
SCOUTING_PASSWORD=defina-uma-senha-forte

CORPO_TECNICO_EMAIL=corpotecnico@adconfianca.com.br
CORPO_TECNICO_PASSWORD=defina-uma-senha-forte

DIRETORIA_EMAIL=diretoria@adconfianca.com.br
DIRETORIA_PASSWORD=defina-uma-senha-forte

# ----------------------------------------------------------------
# BANCO DE DADOS — Vercel Postgres / Neon
# ----------------------------------------------------------------
POSTGRES_URL=postgres://user:password@host/database
POSTGRES_PRISMA_URL=postgres://user:password@host/database?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:password@host/database
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=database

# Algumas rotinas legadas utilizam explicitamente DATABASE_URL.
# Aponte para o mesmo banco ou para a string equivalente do provedor.
DATABASE_URL=postgres://user:password@host/database


# ----------------------------------------------------------------
# BEM-ESTAR / GOOGLE FORMS + GOOGLE SHEETS
# ----------------------------------------------------------------
# Os formulários PRÉ e PÓS do Confiança AINDA NÃO FORAM CRIADOS.
# Por isso, estas duas variáveis ficam vazias nesta versão do repositório.
# Quando os formulários forem criados, publique as respectivas planilhas
# de respostas na web como CSV e informe as URLs abaixo.
# O dashboard consulta essas planilhas por /api/sheets-proxy?source=pre|pos.
# Enquanto vazias, o proxy retorna 503 de configuração ausente (esperado).
WELLNESS_PRE_SHEET_URL=
WELLNESS_POST_SHEET_URL=

# Planilha pública opcional usada pela agenda de observação/scouting.
OBSERVACAO_SHEET_URL=

# ----------------------------------------------------------------
# ARQUIVOS — Vercel Blob
# ----------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ----------------------------------------------------------------
# IA / EXTRAÇÃO ESTRUTURADA
# ----------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Opcional: sobrescreve o modelo usado nos relatórios de treinadores.
OPENAI_TRAINER_MODEL=

# ----------------------------------------------------------------
# AUTOMAÇÕES / CRON
# ----------------------------------------------------------------
# O Vercel Cron envia este valor no header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=gere-uma-string-longa-aleatoria

# ----------------------------------------------------------------
# NOTIFICAÇÕES — opcionais
# ----------------------------------------------------------------
RESEND_API_KEY=
NOTIF_EMAIL=
CALLMEBOT_API_KEY=
WHATSAPP_PHONE=
