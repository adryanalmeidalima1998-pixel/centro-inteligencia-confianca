# ==============================================================
# CENTRO DE INTELIGÊNCIA · ASSOCIAÇÃO DESPORTIVA CONFIANÇA
# Copie para .env.local no desenvolvimento ou cadastre na Vercel.
# ============================================================== 

# AUTENTICAÇÃO
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque-por-uma-string-longa-e-aleatoria

# Conta administrativa: acesso e edição nos dois módulos
AUTH_EMAIL=inteligencia@adconfianca.com.br
AUTH_PASSWORD=troque-esta-senha

# Perfis por módulo
SCOUTING_PASSWORD=troque-esta-senha
CORPO_TECNICO_PASSWORD=troque-esta-senha
DIRETORIA_PASSWORD=troque-esta-senha

# BANCO DE DADOS — Vercel Postgres / Neon
POSTGRES_URL=postgres://user:password@host/database
POSTGRES_PRISMA_URL=postgres://user:password@host/database?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:password@host/database
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=database

# ARQUIVOS — Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# EXTRAÇÃO ESTRUTURADA DE RELATÓRIOS (opcional, usada por rotas já existentes do CIG)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# SPORTMONKS — programação/classificação do módulo Corpo Técnico
SPORTMONKS_API_TOKEN=
# Pode ser definido manualmente; se vazio, a aplicação tenta localizar Confiança pela API.
SPORTMONKS_TEAM_ID=
# Temporada Série C 2026 usada como base histórica. Atualize quando mudar a competição.
SPORTMONKS_SERIE_C_SEASON_ID=27199

# NOTIFICAÇÕES (opcionais)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
NOTIF_EMAIL=destino@exemplo.com
CALLMEBOT_API_KEY=
CRON_SECRET=troque-por-uma-string-longa
